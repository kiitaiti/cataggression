# ---- microCMS（サーバー側のみで使用。NEXT_PUBLIC_ を付けないこと）----
# 例: your-service（https://your-service.microcms.io の "your-service" 部分）
MICROCMS_SERVICE_DOMAIN=
# microCMS 管理画面 > API キー で発行した GET 権限付きキー
MICROCMS_API_KEY=

# ---- 更新反映（Webhook 用のシークレット。任意の長いランダム文字列）----
REVALIDATE_SECRET=

# ---- 公開URL（本番ドメイン決定後に設定。未設定時は canonical/OGP の絶対URLを出力しない）----
# 例: https://example.com
NEXT_PUBLIC_SITE_URL=

# ---- 開発用（通常は未設定）: microCMS API のベース URL を差し替える（モックサーバー検証用）----
# MICROCMS_API_BASE=http://localhost:4000/api/v1
